{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -w \"$LOOKOUT_TTY\" ] && d=\"${LOOKOUT_HOOKS:-${TMPDIR:-/tmp}}\" && f=$(mktemp \"${d%/}/lookout-hook.XXXXXX\") && cat > \"$f\" && printf '\\033]7701;claude-file;%s\\007' \"$f\" > \"$LOOKOUT_TTY\"; exit 0"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -w \"$LOOKOUT_TTY\" ] && d=\"${LOOKOUT_HOOKS:-${TMPDIR:-/tmp}}\" && f=$(mktemp \"${d%/}/lookout-hook.XXXXXX\") && cat > \"$f\" && printf '\\033]7701;claude-file;%s\\007' \"$f\" > \"$LOOKOUT_TTY\"; exit 0"
