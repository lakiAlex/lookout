    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$LOOKOUT_SESSION\" ] && d=\"$LOOKOUT_HOOKS/$LOOKOUT_SESSION\" && [ -d \"$d\" ] && f=$(mktemp \"$d/lookout-hook.XXXXXX\") && cat > \"$f\" && mv \"$f\" \"$f.json\"; exit 0"
          }
        ]
      }
    ]
  }
}
